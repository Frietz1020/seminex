# Dependencies
node_modules

# Local-only archive of files not needed for hosting
/redundant/
/redundent/
/SecureBackups/
/.worktrees/
/docs/
/tmp/
/graphify-out/

# Build output
dist
dev-dist
coverage/
.vite/

# Environment files
.env
.env.*
!.env.example
.env.local

# Supabase CLI runtime and cache files
.supabase-home/
supabase/.temp/
/.supabase-home-attendance/

# Local database exports can contain production or student data.
/backups/
/db-dumps/
/supabase/backups/
*.dump
*.dump.gz
*.pgdump
*.backup

# Obsidian per-machine workspace state (keep vault notes and shared .obsidian/app.json + graph.json)
obsidian-vault/.obsidian/workspace.json
obsidian-vault/.obsidian/workspace-mobile.json
obsidian-vault/.obsidian/cache

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor settings (keep shared extension suggestions only)
.vscode/*
!.vscode/extensions.json
